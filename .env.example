# ── Web app (web/) ──────────────────────────────────────────────
# Public-facing base URL used to build the shareable plan links that the
# app returns. Set this to whatever your reverse proxy / Tailscale serves.
# If unset, the app falls back to the request's forwarded host.
PUBLIC_BASE_URL=http://localhost:3000

# Where the SQLite database file lives (created on first boot).
DATABASE_PATH=./data/post-plan.db

# Port + host the Next.js server binds to. Keep HOSTNAME on localhost so only
# your reverse proxy can reach it (the security boundary is Tailscale).
PORT=3000
HOSTNAME=127.0.0.1

# ── MCP server (mcp/) ───────────────────────────────────────────
# The internal/reachable URL the MCP server calls. Can differ from
# PUBLIC_BASE_URL (this is how the MCP reaches the app; PUBLIC_BASE_URL is
# what humans see in returned links).
POST_PLAN_API_BASE_URL=http://localhost:3000
